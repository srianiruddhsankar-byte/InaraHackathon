# Shared demo sync (optional). Copy to .env.local and fill in; leave empty to run from localStorage only.
# Supabase dashboard → Project Settings → API (or Connect): Project URL and the anon / publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LOCAL SCRIPTS ONLY (scripts/seed-auth.mjs, scripts/reset-mfa.mjs). The service_role / secret key
# bypasses Row Level Security: never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
